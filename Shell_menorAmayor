#include <iostream>
using namespace std;

void shellSort(int a[], int n) {
    
    for (int gap = n / 2; gap > 0; gap /= 2) {

        for (int i = gap; i < n; i++) {
            int temp = a[i];
            int j = i;

            while (j >= gap && a[j - gap] > temp) {
                a[j] = a[j - gap];
                j -= gap;
            }

            a[j] = temp;
        }
    }
}

void mostrar(int a[], int n) {
    for (int i = 0; i < n; i++) {
        cout << a[i] << " ";
    }
    cout << endl;
}

int main() {
    int n;

    cout << "Cantidad de elementos: ";
    cin >> n;

    if (n <= 0) {
        cout << "Cantidad no valida." << endl;
        return 0;
    }

    int* a = new int[n];

    cout << "Ingrese los elementos:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    cout << "Arreglo original: ";
    mostrar(a, n);

    shellSort(a, n);

    cout << "Arreglo ordenado: ";
    mostrar(a, n);

    delete[] a;
    return 0;
}
